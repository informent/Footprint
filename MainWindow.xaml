<Window x:Class="Footprint.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Footprint" Width="1180" Height="780" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"><Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Footprint" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="See what is using your storage." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="A calm, local view of your folders and files." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock Text="LOCAL ONLY  ·  READ-ONLY SCAN" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid><Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="15" Margin="0,26,0,18"><StackPanel Orientation="Horizontal"><Button Content="Choose folder" Click="ChooseFolder_Click"/><Button x:Name="ScanButton" Content="Scan" Click="Scan_Click" Background="{StaticResource Accent}" Foreground="White"/><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/><TextBlock x:Name="PathText" Text="No folder selected" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="0.82*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><Grid><TextBlock Text="Largest locations" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Text="Ready to scan" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid><ListBox x:Name="EntryList" Margin="0,12,0,0" Background="White" BorderBrush="{StaticResource Line}"/></StackPanel><Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="SCAN SUMMARY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Choose a folder to begin." FontSize="17" FontWeight="SemiBold" Margin="0,7,0,16"/><TextBlock x:Name="TotalText" Text=":" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Total discovered size" Foreground="{StaticResource Muted}" Margin="0,3,0,20"/><Separator/><TextBlock Text="READ-ONLY BY DESIGN" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" Margin="0,18,0,0"/><TextBlock Text="Footprint never deletes, moves, or modifies files." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border></Grid><TextBlock Grid.Row="3" Text="Footprint 1.3.1  ·  MIT licensed" Foreground="{StaticResource Muted}" Margin="0,20,0,0"/></Grid></Window>
